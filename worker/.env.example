SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_BOT_TOKEN=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# сколько держать модель в памяти: по умолчанию на Linux-сервере всегда (-1), на Mac 30m
# OLLAMA_KEEP_ALIVE=-1
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo   # на Linux подставится large-v3-turbo для faster-whisper
USE_LAYA=false
LAYA_THRESHOLD=0.8
WORKER_ID=laptop
POLL_INTERVAL=2
# false — не разбирать сообщения, только подписывать быстрые команды (Mac рядом с сервером на Linux)
WORKER_INBOX=true
