SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_BOT_TOKEN=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# сколько держать модель в памяти: по умолчанию на Linux-сервере всегда (-1), на Mac 30m
# OLLAMA_KEEP_ALIVE=-1
# читает фото чеков (Pro); грузится по требованию
# VISION_MODEL=qwen2.5vl:7b
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo   # на Linux подставится large-v3-turbo для faster-whisper
# faster-whisper (Linux): auto — видеокарта, если есть; cpu — отдать видеокарту целиком LLM
# WHISPER_DEVICE=auto
USE_LAYA=false
LAYA_THRESHOLD=0.8
WORKER_ID=laptop
POLL_INTERVAL=2
# false — не разбирать сообщения, только подписывать быстрые команды (Mac рядом с сервером на Linux)
WORKER_INBOX=true
# сколько сообщений разбирать одновременно; Ollama должна принимать столько же (OLLAMA_NUM_PARALLEL).
# Замерить, сколько даёт: .venv/bin/python scripts/drain_bench.py
# WORKER_CONCURRENCY=1

# Только сервер: приватный топик ntfy.sh для деплоя сразу после зелёного CI (тот же, что в секрете
# репозитория NTFY_TOPIC). Пусто — сервер проверяет GitHub раз в 2 минуты. См. README.
DEPLOY_NTFY_TOPIC=
